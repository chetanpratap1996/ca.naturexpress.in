# =====================================================================
# TAXOBRAIN ENTERPRISE ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase PostgreSQL Database (Cloud or Self-Hosted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=https://ca.naturexpress.in
# Server-only Supabase secret/service-role key. Required for firm-managed client invitations.
# Never prefix with NEXT_PUBLIC_ or expose in browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Server-only PostgreSQL connections used for durable tenant state and migrations.
# Never prefix these with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SSL_CA_PATH=C:/secure-path/supabase-prod-ca.crt

# 2. Master CA Firm Identity
NEXT_PUBLIC_FIRM_FRN=
NEXT_PUBLIC_FIRM_NAME=
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_FIRM_SHORT_NAME=
NEXT_PUBLIC_FIRM_TAGLINE=
NEXT_PUBLIC_FIRM_CIN=
NEXT_PUBLIC_FIRM_ADDRESS=
NEXT_PUBLIC_MANAGING_PARTNER=
NEXT_PUBLIC_PARTNER_PHONE=
NEXT_PUBLIC_FIRM_PHONE=
NEXT_PUBLIC_FIRM_WHATSAPP=
NEXT_PUBLIC_PARTNER_WHATSAPP=
NEXT_PUBLIC_FIRM_EMAIL=
NEXT_PUBLIC_PEER_REVIEW_NO=
NEXT_PUBLIC_FIRM_UPI_VPA=
NEXT_PUBLIC_FIRM_BANK_NAME=
NEXT_PUBLIC_FIRM_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_FIRM_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_FIRM_BANK_IFSC=
NEXT_PUBLIC_FIRM_BANK_BRANCH=

# 3. Environment & Security
NODE_ENV=production
NEXTAUTH_SECRET=generate-secure-32-char-random-secret
